<Window x:Class="MultithreadingBenchmark.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Termin 06: Multithreading, TPL &amp; Reaktive WPF-Entkopplung (Amdahl-Dashboard)"
        Height="760" Width="1180"
        Background="#1E1E1E" Foreground="#E0E0E0">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Parallele Partikelsimulation (TPL Parallel.For) &amp; Reaktive UI-Entkopplung"
                               FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock x:Name="TxtSubHeader"
                               Text="Systemsimulation / Digitaler Zwilling – FH Oberösterreich (Campus Wels)"
                               FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnResetParticles" Content="Partikel zurücksetzen" Click="BtnResetParticles_Click" Padding="12,6" Margin="0,0,8,0"/>
                    <Button x:Name="BtnRunScaling" Content="Amdahl-Skalierungsreihe (1..P Kerne)" Click="BtnRunScaling_Click" Padding="12,6" FontWeight="SemiBold" Background="#0E639C" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Left: WriteableBitmap 2D Particle Viewport -->
            <Border Grid.Column="0" Background="#0E1117" CornerRadius="4" BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,10,0">
                <Grid>
                    <Image x:Name="ParticleImage" Stretch="Fill" MouseDown="ParticleImage_MouseDown" Cursor="Cross"/>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#CC1E1E1E" CornerRadius="4" Padding="8,5" Margin="10">
                        <TextBlock Text="Linksklick ins Bild: Gravitations-Attraktor (rotes Fadenkreuz) verschieben" FontSize="11" Foreground="#CCCCCC"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Controls, Telemetry & Amdahl Table -->
            <Border Grid.Column="1" Background="#252526" CornerRadius="4" Padding="14" BorderBrush="#3F3F46" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="1. Simulations- &amp; Thread-Steuerung" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkUseParallel" Content="TPL Parallel.For aktivieren (sonst sequentielle for-Schleife)"
                                  IsChecked="True" Foreground="#E0E0E0" Margin="0,0,0,10"/>

                        <TextBlock Text="MaxDegreeOfParallelism (Thread-Anzahl p):" Foreground="#CCCCCC"/>
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderThreads" Minimum="1" Maximum="16" Value="8" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="SliderThreads_ValueChanged"/>
                            <TextBlock x:Name="TxtThreads" Grid.Column="1" Text="8" Foreground="#4FC3F7" FontWeight="Bold" TextAlignment="Right"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnStart" Grid.Column="0" Content="▶ Simulation starten (200 Schritte)"
                                    Click="BtnStart_Click" Padding="8,8" Margin="0,0,4,0" FontWeight="Bold" Background="#2E7D32" Foreground="White"/>
                            <Button x:Name="BtnCancel" Grid.Column="1" Content="⏹ Not-Aus (Cancel)"
                                    Click="BtnCancel_Click" Padding="8,8" Margin="4,0,0,0" FontWeight="Bold" Background="#C62828" Foreground="White" IsEnabled="False"/>
                        </Grid>

                        <TextBlock Text="Simulationsfortschritt (IProgress&lt;T&gt;):" Foreground="#CCCCCC" FontSize="11" Margin="0,0,0,3"/>
                        <ProgressBar x:Name="SimProgressBar" Minimum="0" Maximum="100" Height="16" Margin="0,0,0,14"/>

                        <Separator Background="#3F3F46" Margin="0,0,0,12"/>

                        <!-- Live Telemetry -->
                        <TextBlock Text="2. Live-Telemetrie &amp; Speedup" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                        <Border Background="#1B2631" CornerRadius="4" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="TxtStepTime" Text="Mittlere Schrittzeit: -- ms/step" FontFamily="Consolas" Foreground="#FFFFFF" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtFps" Text="Simulations-Durchsatz: -- Steps/s (FPS)" FontFamily="Consolas" Foreground="#4FC3F7" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtSpeedup" Text="Gemessener Speedup S(p): -- x" FontFamily="Consolas" Foreground="#81C784" FontWeight="Bold" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtAmdahlS" Text="Serieller Anteil s (Amdahl): -- %" FontFamily="Consolas" Foreground="#FFB74D"/>
                            </StackPanel>
                        </Border>

                        <Separator Background="#3F3F46" Margin="0,0,0,12"/>

                        <!-- Amdahl Scaling Table -->
                        <TextBlock Text="3. Amdahl-Skalierungsreihe (1 .. P Kerne)" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" Margin="0,0,0,6"/>
                        <DataGrid x:Name="ScalingGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="210"
                                  Background="#1E1E1E" Foreground="#E0E0E0" RowBackground="#252526" AlternatingRowBackground="#2D2D30"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderBrush="#3F3F46">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Threads p" Binding="{Binding Threads}" Width="75"/>
                                <DataGridTextColumn Header="Dauer [ms]" Binding="{Binding ElapsedMilliseconds, StringFormat=F2}" Width="90"/>
                                <DataGridTextColumn Header="Speedup S(p)" Binding="{Binding Speedup, StringFormat=F2}" Width="95"/>
                                <DataGridTextColumn Header="Effizienz E(p)" Binding="{Binding Efficiency, StringFormat=P1}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer Status Bar -->
        <Border Grid.Row="2" Background="#2D2D30" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Bereit. N = 100.000 Partikel initialisiert." Foreground="#AAAAAA" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="Kapitel 06: TPL Parallel.For | async/await | IProgress&lt;T&gt; | CancellationToken" Foreground="#777777" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
