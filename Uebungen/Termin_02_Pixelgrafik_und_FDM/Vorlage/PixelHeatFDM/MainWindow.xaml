<Window x:Class="PixelHeatFDM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Termin 02: 2D-Wärmeleitung FDM &amp; WriteableBitmap" 
        Height="650" Width="820"
        Background="#1E1E1E">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="2D Finite-Differenzen-Methode (FDM) &amp; High-Performance Pixelgrafik" 
                           FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                <TextBlock Text="Systemsimulation / Digitaler Zwilling - Fachhochschule Oberösterreich (Campus Wels)" 
                           FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- Render Display -->
            <Border Grid.Column="0" Background="#111111" CornerRadius="4" BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,10,0">
                <Viewbox Stretch="Uniform">
                    <Image x:Name="HeatImage" 
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Width="256" Height="256"
                           SnapsToDevicePixels="True"/>
                </Viewbox>
            </Border>

            <!-- Parameter Controls -->
            <Border Grid.Column="1" Background="#252526" CornerRadius="4" Padding="12" BorderBrush="#3F3F46" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Simulationseinstellungen" FontWeight="Bold" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,10"/>

                        <!-- Controls: Start / Pause / Reset -->
                        <UniformGrid Columns="2" Margin="0,0,0,12">
                            <Button x:Name="BtnStartStop" Content="Start / Pause" Click="BtnStartStop_Click" Margin="0,0,4,0" Height="28"/>
                            <Button x:Name="BtnReset" Content="Zurücksetzen" Click="BtnReset_Click" Margin="4,0,0,0" Height="28"/>
                        </UniformGrid>

                        <!-- Slider Delta t -->
                        <TextBlock Text="Zeitschrittweite Delta t [s]:" Foreground="#D4D4D4" Margin="0,5,0,2"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderDt" Minimum="0.0005" Maximum="0.0040" Value="0.0020" SmallChange="0.0001" LargeChange="0.0005"
                                    ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtDtValue" Text="0.0020 s" Foreground="#9CDCFE" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Slider Alpha -->
                        <TextBlock Text="Temperaturleitfähigkeit alpha [m²/s]:" Foreground="#D4D4D4" Margin="0,10,0,2"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="65"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderAlpha" Minimum="0.2e-4" Maximum="2.0e-4" Value="1.0e-4" SmallChange="0.1e-4" LargeChange="0.2e-4"
                                    ValueChanged="Slider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="TxtAlphaValue" Text="1.00e-4" Foreground="#9CDCFE" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="#3F3F46" Margin="0,15,0,15"/>

                        <!-- Stability Info -->
                        <TextBlock Text="Von-Neumann / CFL-Stabilität:" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,5"/>
                        <Border x:Name="StabilityBadge" Background="#1B4D1B" CornerRadius="3" Padding="8">
                            <StackPanel>
                                <TextBlock x:Name="TxtStabilityFactor" Text="s = 0.2000 (s &lt;= 0.25)" Foreground="#98FB98" FontWeight="Bold"/>
                                <TextBlock x:Name="TxtCriticalDt" Text="dt_krit = 0.0025 s" Foreground="#E0E0E0" FontSize="11" Margin="0,3,0,0"/>
                                <TextBlock x:Name="TxtStabilityStatus" Text="STABIL: Keine Gitterexplosion" Foreground="#D4D4D4" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>

                        <Separator Background="#3F3F46" Margin="0,15,0,15"/>

                        <!-- Boundary Mode -->
                        <TextBlock Text="Randbedingungen:" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,5"/>
                        <RadioButton x:Name="RbDirichlet" Content="Dirichlet (Fest 20 °C)" IsChecked="True" Foreground="#D4D4D4" Checked="RbBoundary_Checked" Margin="0,2,0,2"/>
                        <RadioButton x:Name="RbNeumann" Content="Neumann (Adiabat / Isoliert)" Foreground="#D4D4D4" Checked="RbBoundary_Checked" Margin="0,2,0,2"/>

                        <Separator Background="#3F3F46" Margin="0,15,0,15"/>

                        <!-- Info / Guide -->
                        <TextBlock Text="Aufgaben-Leitfaden:" FontWeight="Bold" Foreground="#CE9178" Margin="0,0,0,4"/>
                        <TextBlock Text="• Stufe A: Erhöhen Sie Dt > 0.0025s und beobachten Sie die Instabilität." 
                                   Foreground="#CCCCCC" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,4"/>
                        <TextBlock Text="• Stufe B: Track A (CPU-Kühler mit Robin-Rand) oder Track B (Falling Sand)." 
                                   Foreground="#CCCCCC" TextWrapping="Wrap" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer / Status Bar -->
        <Border Grid.Row="2" Background="#2D2D30" CornerRadius="4" Padding="8,4" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtStatus" Text="Bereit. 128x128 Gitter @ 30 FPS." Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text=".NET 8 | WriteableBitmap | Single-Threaded FDM" Foreground="#666666" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
