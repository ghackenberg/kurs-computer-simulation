<Window x:Class="DiscreteEventSimulation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Termin 09: Diskrete Ereignissimulation (DES), Future Event List &amp; Little's Gesetz"
        Height="780" Width="1280"
        Background="#1E1E2E" Foreground="#CDD6F4">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Linkes Panel: Parameter & Telemetrie-Dashboard -->
        <Border Grid.Column="0" Background="#181825" CornerRadius="8" Padding="14" BorderBrush="#313244" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="DES / FEL Parameter" FontSize="17" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,10"/>

                    <!-- Systemparameter -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="95"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Ankunftsrate λ [1/min]:" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox x:Name="TxtLambda" Grid.Row="0" Grid.Column="1" Text="4.0" Margin="0,3" Padding="4,2" Background="#313244" Foreground="White" BorderThickness="0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Bedienrate μ [1/min]:" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox x:Name="TxtMu" Grid.Row="1" Grid.Column="1" Text="5.0" Margin="0,3" Padding="4,2" Background="#313244" Foreground="White" BorderThickness="0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Serveranzahl c:" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox x:Name="TxtServers" Grid.Row="2" Grid.Column="1" Text="1" Margin="0,3" Padding="4,2" Background="#313244" Foreground="White" BorderThickness="0"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Kapazität K (0 = unbegrenzt):" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox x:Name="TxtCapacity" Grid.Row="3" Grid.Column="1" Text="0" Margin="0,3" Padding="4,2" Background="#313244" Foreground="White" BorderThickness="0"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Simulationsdauer T_max [min]:" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox x:Name="TxtTMax" Grid.Row="4" Grid.Column="1" Text="20000" Margin="0,3" Padding="4,2" Background="#313244" Foreground="White" BorderThickness="0"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Log-Normal σ_service (Aufg. A2):" VerticalAlignment="Center" Margin="0,3"/>
                        <TextBox x:Name="TxtLogNormalStd" Grid.Row="5" Grid.Column="1" Text="0.40" Margin="0,3" Padding="4,2" Background="#313244" Foreground="White" BorderThickness="0"/>
                    </Grid>

                    <CheckBox x:Name="ChkUseLogNormal" Content="Log-Normal-Bedienzeit aktivieren (Aufgabe A2)" Foreground="#F9E2AF" Margin="0,4,0,10"/>

                    <!-- Aktionsbuttons -->
                    <Button x:Name="BtnRunSingle" Content="▶ 1. Einzellauf simulieren (FEL + Histogramm)"
                            Click="BtnRunSingle_Click"
                            Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" Padding="10,8" Margin="0,0,0,8" BorderThickness="0"/>

                    <Button x:Name="BtnRunMonteCarlo" Content="⚡ 2. Monte-Carlo Replikationen (Aufgabe A3)"
                            Click="BtnRunMonteCarlo_Click"
                            Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Padding="10,8" Margin="0,0,0,12" BorderThickness="0"/>

                    <!-- Kennzahlen-Dashboard -->
                    <Border Background="#11111B" CornerRadius="6" Padding="10" BorderBrush="#313244" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Simulationsergebnisse &amp; Little's Gesetz" FontWeight="Bold" Foreground="#94E2D5" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtKpiSummary" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="#CDD6F4"
                                       Text="Bitte Simulation starten..."/>
                        </StackPanel>
                    </Border>

                    <!-- Monte-Carlo Konfidenzintervall -->
                    <Border Background="#11111B" CornerRadius="6" Padding="10" Margin="0,10,0,0" BorderBrush="#313244" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Monte-Carlo 95%-Konfidenzintervall (Aufgabe A3)" FontWeight="Bold" Foreground="#F9E2AF" Margin="0,0,0,6"/>
                            <TextBlock x:Name="TxtMonteCarloSummary" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Foreground="#CDD6F4"
                                       Text="Noch keine Replikationen berechnet."/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Rechtes Panel: 2 ScottPlot 5 Diagramme -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#181825" CornerRadius="8" Padding="6" BorderBrush="#313244" BorderThickness="1">
                <scottplot:WpfPlot x:Name="PlotHistogram"/>
            </Border>

            <Border Grid.Row="2" Background="#181825" CornerRadius="8" Padding="6" BorderBrush="#313244" BorderThickness="1">
                <scottplot:WpfPlot x:Name="PlotMonteCarlo"/>
            </Border>
        </Grid>
    </Grid>
</Window>
