<Window x:Class="ScottPlotTelemetry.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="Termin 04: Telemetrie-Dashboard, ScottPlot 5 &amp; Welford-Statistik" 
        Height="700" Width="1000"
        Background="#1E1E1E">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <Border Grid.Row="0" Background="#2D2D30" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Industrielle Signal-Telemetrie &amp; Online-Statistik" 
                               FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Systemsimulation / Digitaler Zwilling - Fachhochschule Oberösterreich (Campus Wels)" 
                               FontSize="12" Foreground="#AAAAAA" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnStartStop" Content="Start / Pause" Click="BtnStartStop_Click" Margin="0,0,8,0" Padding="14,6"/>
                    <Button x:Name="BtnReset" Content="Reset" Click="BtnReset_Click" Margin="0,0,8,0" Padding="14,6"/>
                    <Button x:Name="BtnInjectAnomaly" Content="Anomalie injizieren" Click="BtnInjectAnomaly_Click" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Chart & Dashboard Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- ScottPlot 5 WpfPlot -->
            <Border Grid.Column="0" Background="#141414" CornerRadius="4" BorderBrush="#3F3F46" BorderThickness="1" Margin="0,0,10,0">
                <sp:WpfPlot x:Name="Plot1"/>
            </Border>

            <!-- Telemetrie-Statistik Seitenleiste -->
            <Border Grid.Column="1" Background="#252526" CornerRadius="4" Padding="14" BorderBrush="#3F3F46" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Welford-Online-Statistik" FontWeight="Bold" Foreground="#E0E0E0" FontSize="14" Margin="0,0,0,12"/>

                    <TextBlock Text="Messwert-Anzahl (k):" Foreground="#AAAAAA" FontSize="11"/>
                    <TextBlock x:Name="TxtCount" Text="0" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Text="Aktueller Wert y(t):" Foreground="#AAAAAA" FontSize="11"/>
                    <TextBlock x:Name="TxtCurrent" Text="--.-" Foreground="#4EC9B0" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Text="Laufender Mittelwert (Mean):" Foreground="#AAAAAA" FontSize="11"/>
                    <TextBlock x:Name="TxtMean" Text="--.-" Foreground="#9CDCFE" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Text="Standardabweichung (Sigma):" Foreground="#AAAAAA" FontSize="11"/>
                    <TextBlock x:Name="TxtStdDev" Text="--.-" Foreground="#CE9178" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <TextBlock Text="Varianz (s²):" Foreground="#AAAAAA" FontSize="11"/>
                    <TextBlock x:Name="TxtVariance" Text="--.-" Foreground="#DCDCDC" FontSize="13" Margin="0,0,0,8"/>

                    <Separator Background="#3F3F46" Margin="0,8,0,12"/>

                    <TextBlock Text="3-Sigma-Toleranzband:" FontWeight="Bold" Foreground="#E0E0E0" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtToleranceBand" Text="[--.-  ...  --.-]" Foreground="#D7BA7D" FontSize="12" Margin="0,0,0,10"/>

                    <Border x:Name="StatusBadge" Background="#1B4D1B" CornerRadius="3" Padding="8">
                        <TextBlock x:Name="TxtStatusBadge" Text="SIGNAL IM NORMALBEREICH" Foreground="#98FB98" FontWeight="Bold" FontSize="11" TextAlignment="Center"/>
                    </Border>

                    <Separator Background="#3F3F46" Margin="0,15,0,15"/>

                    <TextBlock Text="Hinweis zu ScottPlot 5:" FontWeight="Bold" Foreground="#DCDCDC" Margin="0,0,0,4"/>
                    <TextBlock Text="DataStreamer-Architektur: Allokationsfreie Ringpuffer für 60 FPS ohne GC-Ruckler." 
                               Foreground="#888888" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer / Status Bar -->
        <Border Grid.Row="2" Background="#2D2D30" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFooter" Text="Telemetrie aktiv. Abtastrate: 50 Hz (20 ms DispatcherTimer)." 
                           Foreground="#AAAAAA" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="ScottPlot 5.x | O(1) Welford | 0 Byte GC-Streaming" 
                           Foreground="#666666" FontSize="11" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
