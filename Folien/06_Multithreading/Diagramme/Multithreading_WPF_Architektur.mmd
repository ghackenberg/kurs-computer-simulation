%%{init: {'themeVariables': {'fontSize': '22px'}}}%%
flowchart LR
    subgraph UI ["<b>UI-Thread (WPF Dispatcher)</b>"]
        direction TB
        Start["<b>1. async Button_Click(...)</b><br/>Erzeugt CancellationTokenSource &amp; Progress&lt;T&gt;"]
        Update["<b>4. UI-Aktualisierung</b><br/>Callback via SynchronizationContext<br/>(Plots, ProgressBars, Canvas)"]
    end

    subgraph Pool ["<b>ThreadPool (Hintergrund-Worker)</b>"]
        direction TB
        Worker["<b>2. await Task.Run(...)</b><br/>Rechenintensive Simulation<br/>(Euler / Parallel.For / Monte-Carlo)"]
        Report["<b>3. progress.Report(val)</b><br/>token.ThrowIfCancellationRequested()"]
    end

    Start ==>|"Task starten (Token uebergeben)"| Worker
    Worker --> Report
    Report ==>|"Thread-sicheres Marshalling"| Update
    Worker -.->|"Abschluss / Ergebnis"| Update

    style UI fill:#e8f4fd,stroke:#004B96,stroke-width:2px
    style Pool fill:#fff8e1,stroke:#ffa000,stroke-width:2px
    style Start fill:#ffffff,stroke:#004B96,stroke-width:1.5px
    style Update fill:#d1e7dd,stroke:#0f5132,stroke-width:2px
    style Worker fill:#ffffff,stroke:#ffa000,stroke-width:1.5px
    style Report fill:#ffffff,stroke:#ffa000,stroke-width:1.5px