flowchart LR
    A([Start]) --> B["Zustände initialisieren<br/>Ausgänge & Ableitungen"]
    B --> E{Weiter?}
    
    subgraph Zeitschleife ["Zeitschleife (t = t_max)"]
        direction LR
        E -- Ja --> H
        subgraph Ableitungsschleife ["Ableitungsschleife"]
            direction TB
            H["Zustände integrieren<br/>Ausgänge & Ableitungen<br/>Fehler berechnen"] --> G{Konvergenz?}
            G -- Nein --> H
        end
        G -- Ja --> M["Zeit erhöhen: t += h"]
        M --> E
    end
    
    E -- Nein --> N([Ende])

    style A fill:#333,stroke:#333,color:#fff
    style N fill:#333,stroke:#333,color:#fff
