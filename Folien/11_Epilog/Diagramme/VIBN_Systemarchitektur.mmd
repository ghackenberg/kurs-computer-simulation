flowchart TD
    subgraph Row1 ["Reale Steuerung & Kommunikation"]
        direction LR
        PLC["<b>Reale SPS-Hardware</b><br/>(B&R / Siemens)"] <==>|"E/A-Signale"| BUS["<b>Feldbus / Gateway</b><br/>(EtherCAT / PROFINET)"]
    end
    subgraph Row2 ["Virtuelle Absicherung (Digitaler Zwilling)"]
