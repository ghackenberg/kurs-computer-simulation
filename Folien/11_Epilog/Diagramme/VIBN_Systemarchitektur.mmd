    style PLC fill:#e8f4fd,stroke:#004B96,stroke-width:2px
    style BUS fill:#fff8e1,stroke:#f57f17,stroke-width:2px
    style SIM fill:#e8f8f5,stroke:#00897b,stroke-width:2px
    style VIS fill:#f3e5f5,stroke:#8e24aa,stroke-width:2px
    style Row1 fill:#f8fafc,stroke:#cbd5e1,stroke-width:1.5px
    style Row2 fill:#f8fafc,stroke:#cbd5e1,stroke-width:1.5px
