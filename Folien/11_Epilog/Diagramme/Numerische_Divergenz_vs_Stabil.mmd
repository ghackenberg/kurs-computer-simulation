    style D2 fill:#ffffff,stroke:#c62828,stroke-width:1px
    style D3 fill:#ffffff,stroke:#c62828,stroke-width:1px
    style D4 fill:#ffebee,stroke:#b71c1c,stroke-width:2px
    style S1 fill:#ffffff,stroke:#2e7d32,stroke-width:1px
    style S2 fill:#ffffff,stroke:#2e7d32,stroke-width:1px
