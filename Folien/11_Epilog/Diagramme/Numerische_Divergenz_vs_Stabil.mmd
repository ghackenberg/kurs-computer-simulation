flowchart TD
    subgraph DIV["1. Numerische Divergenz (Δt zu groß / instabil)"]
        direction LR
        D1["Anfangszustand<br/><b>x₀</b>"] --> D2["Aufschaukeln<br/><b>|x₁| &lt; |x₂| &lt; |x₃|</b>"] --> D3["Exponentielles Anwachsen<br/><b>|x| &gt;&gt; x_max</b>"] --> D4["Simulation explodiert<br/><b>Overflow / NaN</b>"]
    end

    DIV ~~~ STAB

    subgraph STAB["2. Stabile Lösung (Δt adäquat / RK4)"]
        direction LR
        S1["Anfangszustand<br/><b>x₀</b>"] --> S2["Dämpfung greift<br/><b>|x₁| &gt; |x₂| &gt; |x₃|</b>"] --> S3["Gedämpftes Einschwingen<br/><b>Phasentrajektorie konvergiert</b>"] --> S4["Stabiler Endzustand<br/><b>x(t) &rarr; Ruhelage</b>"]
    end

    style DIV fill:#fff5f5,stroke:#c62828,stroke-width:2px
