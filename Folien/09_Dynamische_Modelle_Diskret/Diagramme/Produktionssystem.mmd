        direction LR
        Rohmaterial["<b>Rohmaterial</b><br/>Lager"] --> Bearbeitung["<b>Bearbeitung</b><br/>CNC / Fräsen"]
    end
    Puffer["<b>Pufferlager</b><br/>Warteschlange (FIFO)"]
